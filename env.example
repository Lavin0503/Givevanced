TOKEN=your-bot-token
CLIENT_ID=your-application-id
# From Discord Developer Portal -> OAuth2 -> Client Secret (needed for website login)
CLIENT_SECRET=your-client-secret
# Your site address, no trailing slash (also add BASE_URL/callback as a Redirect in the Developer Portal)
BASE_URL=https://giveanced.onrender.com
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# Optional: set to a server ID for instant command updates while testing
GUILD_ID=
